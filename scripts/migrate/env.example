# Copy to .env.migrate at the repo root (gitignored by `.env*`) and fill in.
# The migrate scripts read ONLY these two variables, never MONGODB_URI.

# Always stage. The scripts refuse any database not named fisense-staging.
SOURCE_MONGODB_URI=mongodb+srv://<user>:<pass>@<stage-cluster>/fisense-staging

# Rehearsal (Phase 3): a restored copy of prod, e.g. .../fisense-prod-rehearsal
# Real run (Phase 4):  .../fisense-prod
# Every script also requires --confirm-db=<this database's name>.
TARGET_MONGODB_URI=mongodb+srv://<user>:<pass>@<prod-cluster>/fisense-prod-rehearsal
